# Local .terraform directories (plugin binaries & providers)
**/.terraform/*

# .tfstate files (our state is stored safely in Azure Blob, never on Git!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Sensitive variable files that may contain passwords/secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and plan files
.terraformrc
terraform.rc
*.tfplan
